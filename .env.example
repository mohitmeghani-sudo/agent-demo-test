# Vercel AI Gateway (not needed on Vercel deployments that use OIDC)
AI_GATEWAY_API_KEY=

# Meta Marketing API: system-user token with ads_read only
META_ACCESS_TOKEN=
# Optional: comma-separated allowlist of ad account IDs (act_123,456). Empty = any account the token can see.
META_AD_ACCOUNT_IDS=
# Optional: Graph API version (default v25.0)
META_API_VERSION=

# Shared secret entered in the UI; /api/chat rejects requests without it in production
APP_ACCESS_CODE=
